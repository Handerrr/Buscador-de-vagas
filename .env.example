# Copie este arquivo para .env e ajuste os valores para sua instalação local.
# Nunca coloque senhas ou outras credenciais reais neste arquivo de exemplo.

# Telegram
TELEGRAM_BOT_TOKEN=substitua_pelo_token_do_bot
TELEGRAM_CHAT_ID=substitua_pelo_id_do_chat

# Intervalo do worker Docker (mínimo de 15 minutos)
MONITOR_INTERVAL_MINUTES=60

# Acrescenta exemplos fictícios somente ao painel (não salva nem notifica)
DASHBOARD_DEMO_MODE=true

# Critérios de relevância
# São 15 famílias de cargos, com aliases em português e inglês.
JOB_TITLES=Analista de Dados,Data Analyst,Cientista de Dados,Data Scientist,Engenheiro de Dados,Data Engineer,Analista de Business Intelligence,Business Intelligence Analyst,Desenvolvedor Python,Python Developer,Desenvolvedor Backend,Backend Developer,Desenvolvedor Frontend,Frontend Developer,Desenvolvedor Full Stack,Full Stack Developer,Engenheiro de Software,Software Engineer,Analista de Sistemas,Systems Analyst,Engenheiro de Machine Learning,Machine Learning Engineer,Engenheiro de Inteligência Artificial,AI Engineer,Analista de Segurança da Informação,Information Security Analyst,Engenheiro DevOps,DevOps Engineer,Analista de Qualidade,QA Analyst
JOB_INCLUDED_KEYWORDS=
JOB_EXCLUDED_KEYWORDS=
JOB_LOCATIONS=Brasil,Brazil
JOB_LEVELS=estágio,junior,pleno,senior
JOB_PREFERRED_KEYWORDS=Python,SQL,Power BI,PostgreSQL,ETL,Machine Learning,Inteligência Artificial,Engenharia de Dados,AWS,Azure

# PostgreSQL
# Em hospedagens como Neon, DATABASE_URL substitui as cinco variáveis abaixo.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=job_monitor
DB_USER=postgres
DB_PASSWORD= **
